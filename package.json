{
  "name": "interview-retro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "个人面经复盘库：记录面试被问到的题、当时的回答与复盘结论，按间隔重复复习",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qzh2026/interview-retro.git"
  },
  "homepage": "https://github.com/qzh2026/interview-retro#readme",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "interview",
    "retrospective",
    "spaced-repetition",
    "vue3",
    "typescript",
    "local-first",
    "plugin"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "element-plus": "^2.8.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.0"
  }
}
