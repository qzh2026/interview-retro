{
  "name": "interview-retro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "个人面经复盘库：记录面试被问到的题、当时的回答与复盘结论，按间隔重复复习",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qzh2026/interview-retro.git"
  },
  "homepage": "https://github.com/qzh2026/interview-retro#readme",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "interview",
    "retrospective",
    "spaced-repetition",
    "vue3",
    "typescript",
    "local-first",
    "plugin"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "dev:server": "tsx watch server/index.ts",
    "start:server": "tsx server/index.ts",
    "db:generate": "drizzle-kit generate",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "element-plus": "^2.8.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.0"
  }
}
