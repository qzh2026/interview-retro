# 复制为 .env 后按需修改。真实 .env 已被 .gitignore 忽略，绝不入库。
# 以下全部是占位值 / 默认值，不含任何密钥。
# 鉴权（JWT_*）、AI（AI_API_KEY）等变量在 Stage 4 / 5 引入，届时再补。

NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# libSQL / SQLite 本地文件；内存库可用 :memory:，生产切 PG 时改这里
DATABASE_URL=file:./server/data/interview-retro.db

# 显式来源白名单（逗号分隔）；生产环境禁止通配符 *
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

APP_VERSION=0.1.0

# 前端 API 地址走 VITE_API_BASE_URL（Stage 6 接入），禁止把任何密钥放进 VITE_* 变量
