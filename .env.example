# 复制为 .env 后按需修改。真实 .env 已被 .gitignore 忽略，绝不入库。
# 以下全部是占位值 / 默认值。AI（AI_API_KEY）在 Stage 5 引入。

NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# libSQL / SQLite 本地文件；内存库可用 :memory:，生产切 PG 时改这里
DATABASE_URL=file:./server/data/interview-retro.db

# 显式来源白名单（逗号分隔）；生产环境禁止通配符 *
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

APP_VERSION=0.1.0

# ===== 鉴权（Stage 4）=====
# JWT 签名密钥：生产环境必填（至少 32 字符，用足够随机的值）；
# 开发/测试缺省时自动生成进程级临时密钥（重启后旧访问令牌失效，刷新令牌流会自动重新签发）
# JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# 访问令牌有效期（秒），默认 900 = 15 分钟
JWT_ACCESS_TTL_SECONDS=900

# 刷新令牌有效期（天），默认 30；令牌存 hash、可撤销、每次刷新轮换
REFRESH_TOKEN_TTL_DAYS=30

# /api/auth/* 每分钟每 IP 请求上限（防暴力破解）
AUTH_RATE_LIMIT_MAX=10

# ===== 增量同步（Stage 4）=====
# 单次 push 允许的最大变更条数 / 单次 pull 返回的最大条数
SYNC_MAX_CHANGES_PER_PUSH=200
SYNC_PULL_LIMIT=500

# 前端 API 地址：留空 = 同源（开发由 Vite proxy 转发 /api 到 3001）；
# 跨域部署时设 VITE_API_BASE=https://your-api-host（禁止把任何密钥放进 VITE_* 变量）
# VITE_API_BASE=
# 开发期代理目标（默认 http://127.0.0.1:3001）
# VITE_API_PROXY_TARGET=
